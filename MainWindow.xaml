<Window
    x:Class="GigaPrime3D.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pe="using:Gigasoft.ProEssentials"
    Title="GigaPrime3D - WinUI (3D Surface)">

    <Grid x:Name="RootGrid" Background="#002B35" RequestedTheme="Dark" Loaded="Main_Loaded" SizeChanged="Main_SizeChanged">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="275"/>
            <ColumnDefinition Width="4000*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Left UI panel. (WPF LayoutTransform 1.5x -> FontSize; Label -> TextBlock; wForeColor style -> inline Foreground.) -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" x:Name="ColContainer">
            <Border Grid.Column="0" x:Name="UIColContainer" BorderThickness="1" Visibility="Visible">
                <StackPanel Orientation="Vertical">
                    <ComboBox x:Name="HeightMaps" FontSize="15" Margin="1,6,0,15" MaxWidth="275" MinWidth="275"
                              HorizontalAlignment="Left" VerticalAlignment="Top" Height="32"
                              SelectionChanged="HeightMaps_SelectionChanged" />

                    <CheckBox x:Name="ShowLegend" Foreground="White" FontSize="20" Content="Legend"
                              Checked="ShowLegend_Checked" Unchecked="ShowLegend_UnChecked"
                              HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <CheckBox x:Name="BottomContour" Foreground="White" FontSize="20" Content="Bottom Contour"
                              Checked="ShowContour_Checked" Unchecked="ShowContour_UnChecked"
                              HorizontalAlignment="Left" />
                    <CheckBox x:Name="ShowPlane" Foreground="White" FontSize="20" Content="X Plane"
                              Checked="ShowPlane_Checked" Unchecked="ShowPlane_UnChecked"
                              HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <CheckBox x:Name="HotSpots" Foreground="White" FontSize="20" Content="Cursor Tracking"
                              Checked="HotSpots_Checked" Unchecked="HotSpots_UnChecked"
                              HorizontalAlignment="Left" Margin="0,0,0,12" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock x:Name="ReduceDataLabel" Foreground="White" FontSize="18" Text="Reduce Data"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ReduceDataAmount" Height="32" MinWidth="70" HorizontalAlignment="Left"
                                  Margin="10,0,0,0" SelectionChanged="ReduceDataAmount_SelectionChanged" />
                    </StackPanel>

                    <Button x:Name="HelpButton" Foreground="White" Background="#000000" FontSize="18" Content="Help ?"
                            Click="HelpButton_Click" HorizontalAlignment="Left" Margin="0,0,0,16" />

                    <TextBlock Text="Move Horizontally" Foreground="White" />
                    <Slider x:Name="SliderHorizontalMove" MinWidth="250" MaxWidth="250"
                            ValueChanged="SliderHorizontalMove_OnValueChanged" Minimum="-10" Maximum="10"
                            Margin="5" HorizontalAlignment="Left" />

                    <TextBlock Text="Move Vertically" Foreground="White" />
                    <Slider x:Name="SliderVerticalMove" MinWidth="250" MaxWidth="250"
                            ValueChanged="SliderVerticalMove_OnValueChanged" Minimum="-10" Maximum="10"
                            Margin="5" HorizontalAlignment="Left" />

                    <TextBlock Text="Rotate Light Horizontally" Foreground="White" />
                    <Slider x:Name="SliderHorizontalLightRotation" MinWidth="250" MaxWidth="250"
                            ValueChanged="SliderHorizontalLightRotation_OnValueChanged" Minimum="0" Maximum="360"
                            Margin="5" HorizontalAlignment="Left" />

                    <TextBlock Text="Rotate Light Vertically" Foreground="White" />
                    <Slider x:Name="SliderVerticalLightRotation" MinWidth="250" MaxWidth="250"
                            ValueChanged="SliderVerticalLightRotation_OnValueChanged" Minimum="0" Maximum="360"
                            Margin="5" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2D contour chart (overlay, bottom-left); zoom/pan here drives the 3D chart's manual scale. -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Canvas.ZIndex="1" x:Name="Chart2DContourContainer">
            <pe:PesgoWinUI x:Name="Chart2DContour" Width="360" Height="360" MaxWidth="360" MaxHeight="360"
                           HorizontalAlignment="Left" Margin="0,450,0,0" />
        </Grid>

        <!-- 3D surface + its rotation/zoom/exaggeration sliders. (Pe* events wired in code-behind ctor.) -->
        <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ChartContainer">
            <StackPanel Canvas.ZIndex="2" Margin="0,30,0,0">
                <TextBlock Text="Vertical rotation" Foreground="White" />
                <Slider x:Name="SliderVerticalRotation" MinWidth="250" MaxWidth="250"
                        ValueChanged="SliderVerticalRotation_OnValueChanged" Minimum="-90" Maximum="90"
                        Margin="5" HorizontalAlignment="Left" />
                <TextBlock Text="Horizontal rotation" Foreground="White" />
                <Slider x:Name="SliderHorizontalRotation" MinWidth="250" MaxWidth="250"
                        ValueChanged="SliderHorizontalRotation_OnValueChanged" Minimum="0" Maximum="360"
                        Margin="5" HorizontalAlignment="Left" />
                <TextBlock Text="Magnification / Distance" Foreground="White" />
                <Slider x:Name="SliderZoom" MinWidth="250" MaxWidth="250"
                        ValueChanged="SliderZoom_OnValueChanged" Minimum="-50" Maximum="-5"
                        Margin="5" HorizontalAlignment="Left" />
                <TextBlock Text="Explode Z Axis" Foreground="White" />
                <Slider x:Name="SliderZExaggeration" MinWidth="250" MaxWidth="250"
                        ValueChanged="SliderZExaggeration_OnValueChanged" Minimum="1" Maximum="50" Value="10"
                        Margin="5" HorizontalAlignment="Left" />
            </StackPanel>
            <Border Grid.Row="0" x:Name="PeContainer" BorderThickness="1" Visibility="Visible">
                <pe:Pe3doWinUI x:Name="Chart3DSurface" />
            </Border>
        </Grid>

        <!-- 2D cross-section line chart (right) + the X-plane slider. -->
        <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" x:Name="Chart2DContainer">
            <Grid Grid.Row="0" Margin="0,40,5,5">
                <pe:PesgoWinUI x:Name="Chart2DLine" Margin="0,40,0,45" />
                <StackPanel x:Name="PanelXPlane" Canvas.ZIndex="1" Margin="0,5,0,220">
                    <Slider x:Name="SliderXPlane" Orientation="Horizontal" VerticalAlignment="Bottom"
                            MinWidth="150" MaxWidth="150"
                            ValueChanged="SliderXPlane_OnValueChanged" Minimum="0" Maximum="100"
                            Margin="5" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Window>
